{
  "name": "sam-otel",
  "version": "0.1.0",
  "description": "Lightweight browser SDK for sending OpenTelemetry logs over OTLP/HTTP",
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "J Wielinga",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwielinga/sam-otel.git"
  },
  "license": "EUPL-1.2",
  "homepage": "https://jwielinga.github.io/sam-otel/",
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md",
    "docs"
  ],
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sam.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "docs:start": "pnpm --dir website start",
    "docs:build": "pnpm --dir website build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^24.2.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
